# Copiar a ".env" (gitignoreado) para desarrollo local.
# Valores por defecto ya coinciden con docker-compose.yml de la raíz del monorepo
# (postgres-db expuesto en localhost:5435) — ver ../docker-compose.yml.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=mirroria
DB_PASSWORD=mirroria_password123
DB_NAME=mirroria_db

# OBLIGATORIO (mínimo 32 caracteres): sin él el backend no arranca.
# Generar uno propio con: openssl rand -hex 32
# Ojo: si WAYRA_SECRETO_AVISOS está vacío, la firma de avisos del QR se deriva
# de este valor — rotar JWT_SECRET también rota esa firma (y cierra todas las sesiones).
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (mirroria-frontend en dev = Vite)
CORS_ORIGINS=http://localhost:5174

# Asistente de reportes por IA (CU24). Sin esto, POST /ia/reportes responde 503
# pero POST /ia/reportes/consulta sigue funcionando con una ficha armada a mano.
# Sacar una clave propia del proyecto en https://platform.deepseek.com/api_keys
IA_API_KEY=
IA_MODELO=deepseek-chat

# Cobro por QR dinamico con el banco simulado Wayra. Las dos son OPCIONALES:
# - WAYRA_URL_BASE: a donde lleva el QR al escanearlo (el frontend que sirve
#   /wayra/pagar/:token). Vacia = el origen de PAGOS_URL_EXITO. Para probar con
#   un celular en la misma Wi-Fi: http://<IP-de-tu-PC>:5174
# - WAYRA_SECRETO_AVISOS: secreto HMAC con que el banco firma sus avisos. Vacia
#   = uno derivado de JWT_SECRET.
# - WAYRA_HABILITADO=false apaga el banco simulado (sus rutas responden 404).
#   Hay que apagarlo el dia que haya una pasarela real: Wayra paga sin dinero.
WAYRA_URL_BASE=
WAYRA_SECRETO_AVISOS=
WAYRA_HABILITADO=true

# Minutos que una compra sin pagar retiene su stock antes de cancelarse sola.
PAGOS_MINUTOS_VENCIMIENTO=30
PAGOS_MINUTOS_VENCIMIENTO_MANUAL=1440

# Claves de PRUEBA de Stripe (dashboard.stripe.com, modo Test). Sin ellas, el
# cobro con tarjeta responde 503 y el cobro por QR/efectivo sigue funcionando.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Moneda de cobro con tarjeta. `bob` (por defecto) cobra Bs 80 como Bs 80,00
# (Stripe lo acepta con tarjeta; mínimo ~Bs 6 = 0,50 USD; Amex no acepta BOB).
# Con `usd` el monto en Bs se convierte con STRIPE_TIPO_CAMBIO (Bs por 1 USD)
# y la descripción de la sesión muestra el monto original en Bs.
STRIPE_MONEDA=bob
STRIPE_TIPO_CAMBIO=6.96
PAGOS_URL_EXITO=http://localhost:5174/pago/exito
PAGOS_URL_CANCELACION=http://localhost:5174/pago/cancelado

# Probador virtual (RF13) via Decart (platform.decart.ai, modelo lucy-vton-3.5).
# Sin esto, POST /probador/token responde 503 y /probador en el frontend no
# puede conectar la camara con la IA. Sacar la clave propia en
# https://platform.decart.ai despues de crear cuenta (viene con credito gratis).
DECART_API_KEY=

# Tope de compras online sin pagar por clienta (anti-acaparamiento, por defecto 2).
VENTAS_MAX_COMPRAS_PENDIENTES=2

# Cuenta DUENO_PLATAFORMA del SaaS (Fase 1): administra planes, tiendas y ciudades.
# SaasSeedService la crea al arrancar si ambas están y la contraseña tiene >= 12
# caracteres; sin ellas solo avisa (warn) y no crea nada. Nunca en el código.
PLATAFORMA_EMAIL=
PLATAFORMA_PASSWORD=
