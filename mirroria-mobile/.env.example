# URL de la API del Backend NestJS
# Para pruebas en navegador Web (npm run web) o emulador local:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Para pruebas en Celular Físico vía Wi-Fi:
# Reemplaza con la IP de tu PC en tu red local (ejecuta 'ipconfig' en Windows para verla):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api/v1
