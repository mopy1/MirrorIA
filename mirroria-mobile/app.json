{
  "expo": {
    "name": "MirrorIA",
    "slug": "mirroria-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirroria",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "bo.mirroria.app",
      "adaptiveIcon": {
        "backgroundColor": "#281B89",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#281B89",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear la etiqueta de una prenda en la tienda"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#281B89"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Para verte con la prenda puesta en el probador con IA",
          "microphonePermission": "El probador no usa el micrófono"
        }
      ],
      "expo-dev-client",
      "./plugins/with-gradle-ram"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "ios": {
      "supportsTablet": false
    }
  }
}
