{
  "expo": {
    "name": "MirrorIA",
    "slug": "mirroria-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirroria",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mirroria.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-dev-client",
      "expo-asset",
      "expo-web-browser",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MirrorIA usa la cámara para probarte prendas en vivo con IA."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MirrorIA usa el micrófono solo para dictar tus preguntas de reportes.",
          "speechRecognitionPermission": "MirrorIA convierte tu voz en texto para armar el reporte que pediste."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
